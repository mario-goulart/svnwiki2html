;;; -*- scheme -*-

((synopsis "A program to convert svnwiki syntax to HTML")
 (author "Mario Domenech Goulart")
 (license "BSD")
 (category tools)
 (dependencies qwiki
               svnwiki-sxml
               sxml-transforms)
 (component-options
  (csc-options "-O3" "-d1"))
 (components
  (extension svnwiki2html)
  (program svnwiki2html-cmd
           (install-name svnwiki2html)
           (component-dependencies svnwiki2html))))
